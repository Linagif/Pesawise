# Copy to .env for LOCAL development. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Production only (on the host's dashboard, not in a file) ----
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<long random value; the app refuses to start without it>
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DJANGO_BEHIND_PROXY=True            # when the host terminates HTTPS (Render, Railway, Fly, ...)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# DJANGO_DEMO_ENABLED=True            # shows "Try the demo" (public portfolio site only)
# DJANGO_HSTS_SECONDS=3600            # raise (e.g. 31536000) once HTTPS is confirmed working
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
